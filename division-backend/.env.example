# Supabase project: backend-trail-running (emuojzwieluldwvbskxp, ap-northeast-1)
#
# DATABASE_URL: Session Pooler connection string, postgres role.
# Get it from: Supabase Dashboard > Project Settings > Database > Connection
# string > Session pooler. This role has BYPASSRLS — Go's own validation in
# internal/scan is what enforces the business rules, not Postgres policies.
DATABASE_URL=postgresql://postgres.emuojzwieluldwvbskxp:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Used only to fetch the Auth JWKS for verifying staff JWTs
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json) — no shared secret needed.
SUPABASE_URL=https://emuojzwieluldwvbskxp.supabase.co

PORT=8080
